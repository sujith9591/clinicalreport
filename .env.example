# Clinical Decision Support Agent - Environment Configuration
# Copy to .env and fill in your values

# ============================================================================
# LLM Configuration (Ollama - Local LLaMA Server)
# ============================================================================
LLM_PROVIDER=ollama
LLM_BASE_URL=http://3.94.255.185:11434
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_FACTOR=1.5

# Circuit breaker settings (prevent cascading failures)
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_TIMEOUT=60

# ============================================================================
# Health Check Configuration
# ============================================================================
LLM_HEALTH_CHECK_ENABLED=true
LLM_HEALTH_CHECK_INTERVAL=300

# ============================================================================
# Logging & Observability
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true
ENABLE_REQUEST_TRACING=true
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# Application Mode
# ============================================================================
CLINICAL_MODE=production
FALLBACK_MODE_ENABLED=true
DEBUG_MODE=false

# ============================================================================
# Audit & Compliance
# ============================================================================
AUDIT_LOG_PATH=./audit_logs
AUDIT_LOG_RETENTION_DAYS=2555
ENABLE_HIPAA_COMPLIANCE=true
ENABLE_GDPR_COMPLIANCE=true

# ============================================================================
# Report Output
# ============================================================================
REPORT_DIR=./reports
ENABLE_MARKDOWN_OUTPUT=true
ENABLE_JSON_OUTPUT=true
ENABLE_CITATIONS=true

# ============================================================================
# Performance Tuning
# ============================================================================
RAG_TOP_K=8
RAG_RERANK_TOP_N=5
AGENT_MAX_ITERATIONS=3
GUARDRAIL_TIMEOUT_SECONDS=5

# ============================================================================
# Security
# ============================================================================
ENABLE_INPUT_VALIDATION=true
ENABLE_OUTPUT_VALIDATION=true
ENABLE_PII_DETECTION=true
ENABLE_ENCRYPTION_AT_REST=false
